# ===================================================
# AI Movie Ticket Booking Assistant - Environment Template
# (Copy this to .env and replace with your credentials)
# ===================================================

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///./movie_booking_db.sqlite
# Example MySQL: mysql+pymysql://root:password@localhost:3306/movie_booking_db
# Example Railway Postgres: postgresql://postgres:password@host:port/railway

# Authentication & Security
SECRET_KEY=replace_with_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Assistant Integration (Groq Cloud LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini
LLM_API_KEY=

# Server & Network Configuration (Railway injects PORT automatically)
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
